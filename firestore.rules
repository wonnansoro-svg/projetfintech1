rules_version = '2';

// Règles de sécurité Firestore pour COOPAVEC.
// À DÉPLOYER MANUELLEMENT (firebase deploy --only firestore:rules) après
// relecture — ce fichier n'est pas déployé automatiquement par l'agent.
//
// Limite connue : les écritures sur `wallets` et `guaranteeFund/global` sont
// validées côté client (montants positifs, plafonds de sécurité) mais ne
// sont pas cryptographiquement vérifiées contre le document `contributions`
// correspondant — cela nécessiterait une Cloud Function (plan Blaze) pour
// une garantie bancaire complète. À prévoir avant un déploiement à grande
// échelle avec de vrais fonds.
//
// Limite connue (2) : les droits fins par superviseur (`Profile.permissions` —
// ex. "peut créer un bénéficiaire") ne sont PAS vérifiés ici, seulement côté
// UI (masquage de boutons dans l'app). Ces règles ne garantissent que le rôle
// ("agent"), pas la permission précise — un superviseur techniquement outillé
// pourrait contourner l'UI. Une vraie séparation fine nécessiterait des
// custom claims / Cloud Functions, hors budget de ce projet.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function myRole() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return isSignedIn() && myRole() == "admin"; }
    function isAgent() { return isSignedIn() && myRole() == "agent"; }
    function isInvestor() { return isSignedIn() && myRole() == "investor"; }
    function isFarmer() { return isSignedIn() && myRole() == "farmer"; }

    match /profiles/{uid} {
      // Lecture individuelle élargie aux profils "farmer" pour tout utilisateur connecté :
      // permet à un investisseur de voir le nom d'un agriculteur dont il finance un bon
      // (pas d'énumération globale — `allow list` reste réservé admin/agent ci-dessous).
      allow read: if isOwner(uid) || isAdmin() || (isSignedIn() && resource.data.role == "farmer");
      allow list: if isAdmin() || isAgent();
      allow create: if request.resource.data.uid == uid
        && (
          isOwner(uid)
          || isAdmin()
          || (isAgent() && request.resource.data.role == "farmer") // le superviseur n'ajoute que des bénéficiaires
        )
        && request.resource.data.role in ["farmer", "investor", "agent"]; // "admin" attribué manuellement en console
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.role == resource.data.role
            && request.resource.data.verificationCode == resource.data.verificationCode);
    }

    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if (isOwner(uid) || isAdmin() || isAgent()) && request.resource.data.balance == 0;
      // Un bénéficiaire ne peut qu'augmenter son solde (cotisation, crédit décaissé),
      // jamais le diminuer directement ni au-delà d'un plafond raisonnable par écriture.
      allow update: if isAdmin()
        || ((isOwner(uid) || isAgent())
            && request.resource.data.balance >= resource.data.balance
            && request.resource.data.balance - resource.data.balance <= 5000000)
        // Exception : un investisseur peut diminuer SON PROPRE solde pour acheter un bon
        // (marketplace de financement participatif) — jamais en dessous de 0.
        || (isOwner(uid) && request.resource.data.balance >= 0 && request.resource.data.balance <= resource.data.balance);
    }

    match /parcels/{parcelId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /contributions/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || isAgent(); // le superviseur additionne les cotisations de ses bénéficiaires (requête `in`)
      allow create: if isSignedIn()
        && request.resource.data.amount > 0
        && (
          // Libre-service (Bokanmin / paiement libre par Wave) : uniquement en attente, jamais auto-confirmée.
          (request.resource.data.userId == request.auth.uid && request.resource.data.status == "pending")
          // Collecte en personne par un admin/superviseur, déjà confirmée sur place.
          || ((isAdmin() || isAgent()) && request.resource.data.status == "confirmed")
        );
      // Seul l'admin confirme/rejette une cotisation en attente (et crédite le solde).
      allow update, delete: if isAdmin();
    }

    match /guaranteeFund/global {
      allow read: if isSignedIn();
      // Toute augmentation vient d'une cotisation ; seule l'admin peut faire baisser
      // le fonds disponible (décaissement de crédit) au-delà de la mise à jour du ratio.
      allow write: if isAdmin()
        || (isSignedIn()
            && request.resource.data.totalDeposited >= resource.data.totalDeposited
            && request.resource.data.totalDeposited - resource.data.totalDeposited <= 5000000
            && request.resource.data.totalDisbursedAsCredits == resource.data.totalDisbursedAsCredits);
    }

    match /settings/credit {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /settings/cooperative {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /credits/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || isSignedIn();
      // Seul l'admin génère un bon (le fermier ne demande plus lui-même).
      allow create: if isAdmin()
        && request.resource.data.status == "pending"
        && request.resource.data.investedAmount == 0
        && request.resource.data.creditedAmount == 0;
      allow update: if isAdmin() // valide un paiement investisseur (creditedAmount, passage à "active"), etc.
        // le bénéficiaire approuve/refuse son propre bon en attente
        || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && resource.data.status == "pending"
            && request.resource.data.status in ["approved", "rejected"])
        // marketplace de bons : un investisseur ne peut qu'augmenter investedAmount sur un bon approuvé, jamais au-delà du montant approuvé
        || (isSignedIn()
            && resource.data.status == "approved"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["investedAmount"])
            && request.resource.data.investedAmount > resource.data.investedAmount
            && request.resource.data.investedAmount <= resource.data.approvedAmount);
    }

    match /transactions/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin() || isAgent());
      allow update, delete: if false; // historique immuable
    }

    match /lossClaims/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /bondInvestments/{id} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.investorId == request.auth.uid || resource.data.farmerId == request.auth.uid));
      allow list: if isSignedIn();
      // Resserré : seul un compte au rôle "investor" peut créer un paiement (pas juste
      // n'importe quel utilisateur connecté qui se désignerait investorId == lui-même).
      allow create: if isInvestor()
        && request.resource.data.investorId == request.auth.uid
        && request.resource.data.amount > 0
        && request.resource.data.status == "pending";
      // Seul l'admin valide (approuve/rejette) un paiement en attente.
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /phoneIndex/{phone} {
      // Lecture par clé connue uniquement (nécessaire avant authentification pour résoudre
      // téléphone → email) — pas de `list`, donc pas d'énumération possible des numéros.
      allow get: if true;
      allow list: if false;
      // Auto-inscription : l'email inscrit doit être celui du compte qui vient d'être créé.
      // Création d'un compte pour un tiers (bénéficiaire sans email personnel) par un admin ou un superviseur.
      allow create, update: if isSignedIn() && (request.resource.data.email == request.auth.token.email || isAdmin() || isAgent());
      allow delete: if isAdmin();
    }

    match /susuGroups/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isAgent();
    }

    match /marketplaceListings/{id} {
      allow read: if isAdmin() || isAgent() || (isSignedIn() && resource.data.farmerId == request.auth.uid);
      allow list: if isSignedIn(); // catalogue parcourable par tous, comme `credits`
      allow create: if isFarmer() && request.resource.data.farmerId == request.auth.uid && request.resource.data.status == "active";
      allow update: if isAdmin()
        // le fermier ne peut qu'annuler sa propre annonce encore active
        || (isFarmer() && resource.data.farmerId == request.auth.uid && resource.data.status == "active"
            && request.resource.data.status in ["active", "cancelled"]);
      allow delete: if false;
    }

    match /marketplaceOrders/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.farmerId == request.auth.uid);
      allow list: if isAdmin();
      // Seul l'admin/coop enregistre et valide les commandes (acheteur externe à l'app).
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /trainingModules/{id} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /trainingProgress/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && request.resource.data.uid == uid;
    }

    match /equipmentCatalog/{id} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /equipmentRequests/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.farmerId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isFarmer() && request.resource.data.farmerId == request.auth.uid
        && request.resource.data.status == "pending" && request.resource.data.linkedCreditId == null;
      // Seul l'admin décide (approve/reject) — voir equipmentService.approveEquipmentRequest.
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /notifications/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || isSignedIn();
      // Émises par une action admin (décision de crédit...) pour un autre utilisateur,
      // ou par n'importe quel utilisateur connecté vers le canal diffusé "admins"
      // (ex. nouvelle cotisation à valider) — contenu informatif, pas d'accès financier.
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == "admins");
      // Le bénéficiaire ne peut que marquer ses propres notifications comme lues.
      allow update: if isAdmin()
        || (isOwner(resource.data.userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]));
      allow delete: if isAdmin();
    }
  }
}
