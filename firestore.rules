rules_version = '2';

// Règles de sécurité Firestore pour COOPAVEC.
// À DÉPLOYER MANUELLEMENT (firebase deploy --only firestore:rules) après
// relecture — ce fichier n'est pas déployé automatiquement par l'agent.
//
// Limite connue : les écritures sur `wallets` et `guaranteeFund/global` sont
// validées côté client (montants positifs, plafonds de sécurité) mais ne
// sont pas cryptographiquement vérifiées contre le document `contributions`
// correspondant — cela nécessiterait une Cloud Function (plan Blaze) pour
// une garantie bancaire complète. À prévoir avant un déploiement à grande
// échelle avec de vrais fonds.
//
// Limite connue (2) : les droits fins par superviseur (`Profile.permissions` —
// ex. "peut créer un bénéficiaire") ne sont PAS vérifiés ici, seulement côté
// UI (masquage de boutons dans l'app). Ces règles ne garantissent que le rôle
// ("agent"), pas la permission précise — un superviseur techniquement outillé
// pourrait contourner l'UI. Une vraie séparation fine nécessiterait des
// custom claims / Cloud Functions, hors budget de ce projet.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function myRole() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return isSignedIn() && myRole() == "admin"; }
    function isAgent() { return isSignedIn() && myRole() == "agent"; }

    match /profiles/{uid} {
      // Lecture individuelle élargie aux profils "farmer" pour tout utilisateur connecté :
      // permet à un investisseur de voir le nom d'un agriculteur dont il finance un bon
      // (pas d'énumération globale — `allow list` reste réservé admin/agent ci-dessous).
      allow read: if isOwner(uid) || isAdmin() || (isSignedIn() && resource.data.role == "farmer");
      allow list: if isAdmin() || isAgent();
      allow create: if request.resource.data.uid == uid
        && (
          isOwner(uid)
          || isAdmin()
          || (isAgent() && request.resource.data.role == "farmer") // le superviseur n'ajoute que des bénéficiaires
        )
        && request.resource.data.role in ["farmer", "investor", "agent"]; // "admin" attribué manuellement en console
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.role == resource.data.role
            && request.resource.data.verificationCode == resource.data.verificationCode);
    }

    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if (isOwner(uid) || isAdmin() || isAgent()) && request.resource.data.balance == 0;
      // Un bénéficiaire ne peut qu'augmenter son solde (cotisation, crédit décaissé),
      // jamais le diminuer directement ni au-delà d'un plafond raisonnable par écriture.
      allow update: if isAdmin()
        || ((isOwner(uid) || isAgent())
            && request.resource.data.balance >= resource.data.balance
            && request.resource.data.balance - resource.data.balance <= 5000000)
        // Exception : un investisseur peut diminuer SON PROPRE solde pour acheter un bon
        // (marketplace de financement participatif) — jamais en dessous de 0.
        || (isOwner(uid) && request.resource.data.balance >= 0 && request.resource.data.balance <= resource.data.balance);
    }

    match /parcels/{parcelId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /contributions/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || isAgent(); // le superviseur additionne les cotisations de ses bénéficiaires (requête `in`)
      allow create: if isSignedIn()
        && (request.resource.data.userId == request.auth.uid || isAdmin() || isAgent())
        && request.resource.data.amount > 0
        && request.resource.data.status == "confirmed";
      allow update, delete: if isAdmin();
    }

    match /guaranteeFund/global {
      allow read: if isSignedIn();
      // Toute augmentation vient d'une cotisation ; seule l'admin peut faire baisser
      // le fonds disponible (décaissement de crédit) au-delà de la mise à jour du ratio.
      allow write: if isAdmin()
        || (isSignedIn()
            && request.resource.data.totalDeposited >= resource.data.totalDeposited
            && request.resource.data.totalDeposited - resource.data.totalDeposited <= 5000000
            && request.resource.data.totalDisbursedAsCredits == resource.data.totalDisbursedAsCredits);
    }

    match /settings/credit {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /credits/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.approvedAmount == null;
      allow update: if isAdmin() // approuve, rejette ou décaisse
        // marketplace de bons : un investisseur ne peut qu'augmenter investedAmount, jamais au-delà du montant approuvé
        || (isSignedIn()
            && resource.data.status in ["approved", "active"]
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["investedAmount"])
            && request.resource.data.investedAmount > resource.data.investedAmount
            && request.resource.data.investedAmount <= resource.data.approvedAmount);
    }

    match /transactions/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin() || isAgent());
      allow update, delete: if false; // historique immuable
    }

    match /lossClaims/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /bondInvestments/{id} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.investorId == request.auth.uid || resource.data.farmerId == request.auth.uid));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.investorId == request.auth.uid && request.resource.data.amount > 0;
      allow update, delete: if false;
    }

    match /susuGroups/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isAgent();
    }

    match /notifications/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || isSignedIn();
      // Émises par une action admin (décision de crédit...) pour un autre utilisateur.
      allow create: if isAdmin();
      // Le bénéficiaire ne peut que marquer ses propres notifications comme lues.
      allow update: if isAdmin()
        || (isOwner(resource.data.userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]));
      allow delete: if isAdmin();
    }
  }
}
